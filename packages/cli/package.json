{
  "name": "@botiverse/raft",
  "version": "0.0.33",
  "license": "FSL-1.1-ALv2",
  "description": "Canonical Raft agent-facing CLI. Provides raft plus the legacy slock alias over the same CLI core. Invoked by daemon-spawned agent processes via injected env vars.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "raft": "dist/raft.js",
    "slock": "dist/slock.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/raft-source.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --watch --import @oxc-node/core/register src/index.ts",
    "start": "node --import @oxc-node/core/register src/index.ts",
    "build": "tsdown && node scripts/write-dist-package.mjs",
    "test": "node scripts/run-tests-with-manifest.mjs",
    "test:update-manifest": "node scripts/run-tests-with-manifest.mjs --update-manifest",
    "typecheck": "tsc --noEmit",
    "lint:publish-package": "node scripts/check-publish-package.mjs"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "commander": "^12.1.0",
    "safe-regex2": "5.1.1",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@botiverse/raft-shared": "workspace:*",
    "@oxc-node/core": "^0.1.3",
    "@types/node": "^25.5.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
