{
  "name": "@botiverse/raft-runtime-form",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./released/*.json": "./released/*.json",
    "./fixtures/*.json": "./fixtures/*.json",
    "./generated/*": "./generated/*"
  },
  "scripts": {
    "contract:generate": "node contract/generate.mjs",
    "contract:check": "node contract/generate.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@botiverse/raft-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
