{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["node"],
    "declaration": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tsdown.config.ts"],
  "exclude": ["src/**/*.test.ts"]
}
