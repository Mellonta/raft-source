{
  "name": "@botiverse/raft-sdk",
  "version": "0.12.1",
  "license": "FSL-1.1-ALv2",
  "description": "Typed Raft Agent API client for external agents and bots.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./operations.json": "./operations.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "operations.json"
  ],
  "sideEffects": false,
  "dependencies": {
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/raft-source.git",
    "directory": "packages/raft-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:artifact": "pnpm run build && node scripts/check-packed-artifact.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run test && pnpm run test:artifact",
    "lint:publish-package": "node scripts/check-publish-package.mjs && node scripts/check-publish-workflow.mjs",
    "typecheck": "tsc --noEmit",
    "generate:operations": "node --import @oxc-node/core/register scripts/generate-operations.ts"
  },
  "devDependencies": {
    "@botiverse/raft-shared": "workspace:*",
    "@types/node": "^25.5.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
