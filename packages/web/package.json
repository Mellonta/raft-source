{
  "name": "@botiverse/raft-web",
  "version": "1.17.5",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-devtools-prod-bundle.mjs && node scripts/check-feedback-workspace-split.mjs && node scripts/check-immutable-assets.mjs && node scripts/check-activity-chunk-split.mjs",
    "build:h5-bundle": "node scripts/build-h5-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-source-extensions.mjs && oxlint --react-plugin --max-warnings=0 src visual-testing && oxlint -c scripts/oxlint-unused-vars.json --disable-nested-config --max-warnings=0 tests && node scripts/check-color-tokens.mjs && node scripts/check-resize-handle-touch-action.mjs && node scripts/check-embed-wiring.mjs && node scripts/check-host-bridge-callers.mjs && node scripts/check-orphan-animations.mjs && node scripts/check-banner-inline-action.mjs && pnpm run lint:i18n-literals",
    "lint:i18n-literals": "node scripts/check-i18n-literals.mjs",
    "lint:fix": "oxlint --react-plugin --fix src visual-testing && oxlint -c scripts/oxlint-unused-vars.json --disable-nested-config --fix tests",
    "test": "node scripts/run-vitest-tests.mjs",
    "test:dom": "node scripts/run-vitest-tests.mjs --dom",
    "test:e2e": "playwright test",
    "test:e2e:direct-upload": "playwright test --config playwright.direct-upload.config.ts",
    "test:e2e:desktop-handshake": "playwright test --config playwright.desktop-handshake.config.ts",
    "test:e2e:staging-onboarding": "playwright test --config playwright.staging.config.ts",
    "generate:reactions": "node scripts/generate-reaction-sprites.mjs"
  },
  "dependencies": {
    "@botiverse/hands-feedback-react": "0.4.1",
    "@botiverse/raft-runtime-form": "workspace:*",
    "@botiverse/raft-shared": "workspace:*",
    "@botiverse/raft-sync-core": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@raft/desktop-contract": "workspace:*",
    "@tanstack/react-virtual": "^3.14.6",
    "ajv": "8.17.1",
    "axios": "^1.14.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "emoji-picker-react": "4.19.1",
    "flexlayout-react": "0.9.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.575.0",
    "mermaid": "11.16.0",
    "raft-ui": "0.5.18",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-intl": "^7.1.11",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "socket.io-client": "^4.8.3",
    "uqr": "^0.1.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "2.11.4",
    "@oxc-node/core": "^0.1.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bippy": "^0.5.41",
    "es-module-lexer": "2.3.0",
    "esbuild": "^0.25.0",
    "eslint-plugin-formatjs": "^6.4.20",
    "fast-check": "^4.8.0",
    "global-jsdom": "^29.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.83.0",
    "oxlint-plugin-react-doctor": "^0.2.9",
    "postcss": "^8.5.8",
    "react-grab": "0.1.48",
    "react-scan": "0.5.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
