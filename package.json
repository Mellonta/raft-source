{
  "name": "raft",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "check:misc": "bash scripts/check-misc.sh",
    "perf:boot-profile": "node scripts/perf/boot-profile.cjs",
    "test:raftdev": "vitest run scripts/dev/",
    "test:computer-browser-upgrade": "vitest run scripts/e2e/computer-browser-upgrade/run-upgrade-e2e.test.mjs",
    "test:source-available": "vitest run scripts/source-available/export-snapshot.test.mjs scripts/source-available/release.test.mjs",
    "typecheck:raftdev": "tsc -p tsconfig.raftdev.json",
    "test:web": "node packages/web/scripts/run-vitest-tests.mjs",
    "test:web:dom": "node packages/web/scripts/run-vitest-tests.mjs --dom",
    "test:ax-book": "vitest run scripts/visualize/ax-surfaces/book.test.mjs"
  },
  "devDependencies": {
    "@oxc-node/core": "^0.1.3",
    "marked": "^18.0.7",
    "playwright": "^1.59.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.2"
  }
}
